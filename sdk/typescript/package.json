{
  "name": "@niubai/pdfedit",
  "version": "0.1.0",
  "description": "TypeScript client for the PDF Edit API: replace, redact, insert and read text in existing PDFs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zp130221/pdfedit-mcp.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/zp130221/pdfedit-mcp/tree/main/sdk/typescript#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "tsx scripts/gen-schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
